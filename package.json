{
  "name": "electron-hr-system-demo-version",
  "version": "1.0.2",
  "main": "electron/main.js",
  "author": "Habib",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"cross-env NODE_ENV=development electron .\"",
    "build": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "mysql2": "^3.16.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.habib.hr",
    "productName": "HR Docs",
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "backend/src/templates/**",
      "backend/src/fonts/**"
    ],
    "extraResources": [
      {
        "from": "backend/src/db/shema.sql",
        "to": "backend/src/db/shema.sql"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/favicon2.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
